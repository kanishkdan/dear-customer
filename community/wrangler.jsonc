{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bouncer-list",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": { "directory": "./public" },
  "vars": {
    "REPO_URL": "https://github.com/kanishkdan/dear-customer",
    "SITE_URL": "https://dearcustomer.kanishkdan.com",
    "STORE_URL": "https://chromewebstore.google.com/detail/dear-customer/lleodoeagdgcfbjcippnlijaikehgfpe",
    "YOUTUBE_VIDEO_ID": "OnTBwxdliI0",
    "MIN_REPORTERS": "3"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "dearcustomer.kanishkdan.com", "custom_domain": true },
    { "pattern": "bouncer.kanishkdan.com", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "bouncer-list", "database_id": "0ca57e61-4f0f-4813-a859-ed37d80a0bab" }
  ],
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
